# ==============================================================================
# Security & Credentials (証明書・秘密鍵・機密情報)
# ==============================================================================
*.pem
*.key
*.crt
*.csr
*.cer
*.pfx
*.p12

# Nginx SSL ディレクトリ内の証明書・秘密鍵
nginx/ssl/*
!nginx/ssl/.gitkeep

# 環境変数・認証情報
.env
.env.*
!.env.example
*.secret
*.token

# ==============================================================================
# Workspace Scratch & Internal Logs (作業一時領域・運用ログ)
# ==============================================================================
scratch/
logs/
tools/*
!tools/profile_builder/
config/*
!config/.gitkeep
*.log

# ==============================================================================
# Speaker Profiles & Replacements (話者特化プロファイル・置換辞書・個人データ)
# ==============================================================================
profiles/
!profiles/.gitkeep
config/profiles/
!config/profiles/.gitkeep
*.profile.json
*_replace.txt
*gemini_key*

